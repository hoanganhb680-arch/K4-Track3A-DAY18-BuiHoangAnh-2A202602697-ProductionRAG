# cp .env.example .env
# Set one key for answer generation, enrichment and RAGAS evaluation.
# LLM_PROVIDER=gemini
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Gemini is preferred when both keys are set; DeepSeek defaults to deepseek-chat.
# Optional overrides:
# LLM_MODEL=gemini-3.1-flash-lite
# RAGAS_MODEL=gemini-3.1-flash-lite
